                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst responseBody = pm.response.json();\r\n\r\npm.test(\"Response code is 200\", function () {\r\n    pm.expect(responseBody.responseCode).to.eql(200);\r\n});\r\n\r\npm.test(\"Products list is not empty\", function () {\r\n    pm.expect(responseBody.products).to.be.an(\"array\");\r\n    pm.expect(responseBody.products).to.not.be.empty;\r\n});\r\n\r\npm.test(\"Product contains all required fields\", function () {\r\n    const product = responseBody.products[0];\r\n\r\n    pm.expect(product).to.have.property(\"id\");\r\n    pm.expect(product).to.have.property(\"name\");\r\n    pm.expect(product).to.have.property(\"price\");\r\n    pm.expect(product).to.have.property(\"brand\");\r\n    pm.expect(product).to.have.property(\"category\");\r\n});\r\n\r\npm.test(\"Product category contains category details\", function () {\r\n    const product = responseBody.products[0];\r\n\r\n    pm.expect(product.category).to.be.an(\"object\");\r\n    pm.expect(product.category).to.have.property(\"category\");\r\n});\r\n\r\npm.test(\"Content-Type header is present\", function () {\r\n    const contentType = pm.response.headers.get(\"Content-Type\");\r\n\r\n    pm.expect(contentType).to.exist;\r\n});\r\n\r\npm.test(\"Content-Type header returns observed value\", function () {\r\n    const contentType = pm.response.headers.get(\"Content-Type\");\r\n\r\n    pm.expect(contentType).to.eql(\"text/html; charset=utf-8\");\r\n});"
